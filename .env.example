# Public browser configuration for the static export.
# Use only a Supabase publishable key here. Never use a secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_REPLACE_ME

# Canonical HTTPS origin used in party invitation links.
NEXT_PUBLIC_APP_URL=https://splitparty.vercel.app
